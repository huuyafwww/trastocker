{
  "name": "trastocker",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "build:libraries": "turbo run build --filter=@trastocker/*-definition --filter=@trastocker/*-helper",
    "clean": "turbo run clean && pnpm run clean:self",
    "clean:self": "rimraf .next node_modules dist .turbo",
    "create:package": "turbo gen package && pnpm install",
    "dev": "turbo run dev",
    "lint:code": "turbo lint:code",
    "lint:type": "turbo lint:type",
    "sort:package": "sort-package-json 'package.json' 'apps/*/package.json' 'definitions/*/package.json'",
    "test": "turbo run test --filter=@trastocker/app-*"
  },
  "devDependencies": {
    "@praha/eslint-config-definer": "^2.0.1",
    "@turbo/gen": "^2.5.0",
    "@types/node": "^22.14.1",
    "eslint": "9.18.0",
    "jiti": "^2.4.2",
    "lefthook": "^1.11.10",
    "rimraf": "^6.0.1",
    "sort-package-json": "^2.15.1",
    "turbo": "^2.5.0",
    "wrangler": "^4.12.0"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "drizzle-orm": "patches/drizzle-orm.patch",
      "msw": "patches/msw.patch"
    }
  }
}
