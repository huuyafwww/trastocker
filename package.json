{
  "name": "trastocker",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "build:libraries": "turbo run build --filter=@trastocker/*-definition --filter=@trastocker/*-helper",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint:code": "turbo lint:code",
    "lint:type": "turbo lint:type",
    "sort:package": "sort-package-json 'package.json' 'apps/*/package.json' 'definitions/*/package.json' 'middlewares/*/package.json'",
    "test": "turbo run test --filter=@trastocker/app-*"
  },
  "devDependencies": {
    "@praha/eslint-config-definer": "^2.0.1",
    "@types/node": "^22.12.0",
    "eslint": "9.18.0",
    "jiti": "^2.4.2",
    "lefthook": "^1.10.10",
    "rimraf": "^6.0.1",
    "sort-package-json": "^2.14.0",
    "turbo": "^2.3.4",
    "wrangler": "^3.107.3"
  },
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "msw": "patches/msw.patch"
    }
  }
}
