{
  "name": "@trastocker/app-backend-server",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:schema": "tsx scripts/write-schema.ts",
    "clean": "rimraf node_modules .turbo",
    "database:seed:local": "dotenv -e .dev.vars -- dotenv -v DATABASE_URL=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) -- tsx ./seeds/index.ts",
    "deploy": "wrangler deploy",
    "dev": "npm-run-all --parallel dev:server dev:schema",
    "dev:schema": "tsx watch --include 'src/graphql/**/*.ts' scripts/write-schema.ts",
    "dev:server": "wrangler dev --env dev",
    "lint:code": "eslint . --cache",
    "lint:type": "tsc --pretty --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "dependencies": {
    "@escape.tech/graphql-armor-block-field-suggestions": "^3.0.1",
    "@graphql-yoga/plugin-disable-introspection": "^2.16.2",
    "@pothos/core": "^4.9.1",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@pothos/plugin-simple-objects": "^4.1.3",
    "@trastocker/database-definition": "workspace:*",
    "@trastocker/drizzle-helper": "workspace:*",
    "@trastocker/typescript-utility-helper": "workspace:*",
    "@trastocker/validation-schema-definition": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@whatwg-node/server-plugin-cookies": "^1.0.5",
    "bcryptjs": "^2.4.3",
    "dedent": "^1.7.0",
    "drizzle-orm": "^0.39.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.2",
    "inversify": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nanoid": "^5.1.5",
    "neverthrow": "^8.2.0",
    "pothos-plugin-valibot": "^0.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.8.0",
    "uuid": "^11.1.0",
    "valibot": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250919.0",
    "@huuyafwww/eslint-config-common": "^1.3.0",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/tsconfig-common": "^1.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^0.7.34",
    "@types/react": "^19.1.13",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "has-throw": "^1.0.3",
    "npm-run-all2": "^7.0.2",
    "tsx": "^4.20.5",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
