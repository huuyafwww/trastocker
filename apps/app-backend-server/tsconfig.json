{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@huuyafwww/tsconfig-common",
  ],
  "compilerOptions": {
    "paths": {
      "@application/*": [
        "./src/application/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@graphql/*": [
        "./src/graphql/*"
      ],
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@test/*": [
        "./tests/*"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "@types/node",
      "@cloudflare/workers-types",
      "@types/jsonwebtoken",
      "vitest/globals"
    ]
  },
}
