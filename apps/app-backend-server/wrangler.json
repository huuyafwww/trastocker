{
  "name": "trastocker",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "main": "src/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trastocker",
      "database_id": "f33035ec-c9be-47bb-bff8-d182b3b722bf"
    }
  ],
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trastocker",
          "database_id": "f33035ec-c9be-47bb-bff8-d182b3b722bf"
        }
      ],
      "vars": {
        "APP_ENV": "local",
        "NODE_ENV": "development",
        "APP_DOMAIN": "localhost"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trastocker",
          "database_id": "f33035ec-c9be-47bb-bff8-d182b3b722bf"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "NODE_ENV": "production"
      }
    }
  }
}
