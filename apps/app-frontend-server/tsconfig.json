{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@huuyafwww/tsconfig-next",
  ],
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./src/components/*",
      ],
      "@constants/*": [
        "./src/constants/*",
      ],
      "@hooks/*": [
        "./src/hooks/*",
      ],
      "@layouts/*": [
        "./src/layouts/*",
      ],
      "@locales*": [
        "./src/locales/*",
        "./src/locales/index.ts",
      ],
      "@mocks/*": [
        "./mocks/*",
      ],
      "@pages/*": [
        "./src/pages/*",
      ],
      "@styles/*": [
        "./src/styles/*",
      ],
    },
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
  ],
  "exclude": [
    "node_modules",
  ]
}
