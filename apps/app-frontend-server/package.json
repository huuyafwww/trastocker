{
  "name": "@trastocker/app-frontend-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rimraf node_modules .turbo",
    "deploy": "pnpm pages:build && wrangler pages deploy",
    "dev": "npm-run-all --parallel dev:server dev:storybook dev:mock-database",
    "dev:server": "next dev",
    "dev:storybook": "storybook dev -p 6006",
    "dev:mock-database": "tsx watch --include 'seeders/*.ts' scripts/generate-mock-database.ts",
    "install:chrome": "node node_modules/puppeteer/install.mjs",
    "lint": "next lint",
    "lint:code": "eslint . --cache",
    "lint:type": "tsc --pretty --noEmit",
    "pages:build": "pnpm next-on-pages",
    "preview": "pnpm pages:build && wrangler pages dev",
    "storybook:build": "storybook build --test",
    "storybook:screenshot": "storycap http://localhost:6007 --serverCmd 'http-server storybook-static --port 6007'",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "generate:mock-database": "tsx scripts/generate-mock-database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@trastocker/graphql-definition": "workspace:*",
    "@trastocker/typescript-utility-helper": "workspace:*",
    "@trastocker/validation-schema-definition": "workspace:*",
    "@vanilla-extract/css": "^1.17.1",
    "daisyui": "^4.12.24",
    "es-toolkit": "^1.35.0",
    "framer-motion": "^12.7.4",
    "graphql": "^16.10.0",
    "lucide-react": "^0.474.0",
    "ms": "^2.1.3",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-aria": "^3.39.0",
    "react-aria-components": "^1.8.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-toastify": "^11.0.5",
    "react-use": "^17.6.0",
    "ress": "^5.0.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "urql": "^4.2.2",
    "valibot": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.12",
    "@cloudflare/workers-types": "^4.20250421.0",
    "@huuyafwww/eslint-config-browser": "^1.2.0",
    "@huuyafwww/eslint-config-common": "^1.2.0",
    "@huuyafwww/eslint-config-next": "^1.2.0",
    "@huuyafwww/eslint-config-react": "^1.2.0",
    "@huuyafwww/eslint-config-storybook": "^1.2.0",
    "@huuyafwww/tsconfig-common": "^1.1.2",
    "@huuyafwww/tsconfig-next": "^1.2.1",
    "@storybook/addon-actions": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-nextjs-vite": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trastocker/database-definition": "workspace:*",
    "@trastocker/drizzle-helper": "workspace:*",
    "@trastocker/nodejs-utility-helper": "workspace:*",
    "@types/ms": "^0.7.34",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sql.js": "^1.4.9",
    "@vanilla-extract/next-plugin": "^2.4.10",
    "@vanilla-extract/vite-plugin": "^5.0.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.6",
    "drizzle-orm": "^0.39.3",
    "happy-dom": "^16.8.1",
    "http-server": "^14.1.1",
    "msw": "^2.7.5",
    "msw-storybook-addon": "^2.0.4",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.3",
    "puppeteer": "^24.6.1",
    "reg-keygen-git-hash-plugin": "^0.14.3",
    "reg-notify-github-plugin": "^0.14.4",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.4",
    "sql.js": "1.12.0",
    "storybook": "^8.6.12",
    "storycap": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
