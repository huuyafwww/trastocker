{
  "name": "@trastocker/database-definition",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "clean": "rimraf node_modules dist .turbo",
    "database:local": "dotenv -v DATABASE_URL=$(find ../../apps/app-backend-server/.wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) -- drizzle-kit studio",
    "database:production": "drizzle-kit studio",
    "dev": "pkgroll --watch",
    "generate:database-schema": "tsx scripts/generate-database-schema.ts",
    "lint:code": "eslint . --cache",
    "lint:type": "tsc --pretty --noEmit",
    "migrate:apply:local": "wrangler d1 migrations apply trastocker --local --persist-to ../../apps/app-backend-server/.wrangler/state",
    "migrate:apply:remote": "wrangler d1 migrations apply trastocker --remote",
    "migrate:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.2.1",
    "@huuyafwww/eslint-config-node": "^1.2.1",
    "@huuyafwww/tsconfig-common": "^1.1.2",
    "@types/sql.js": "^1.4.9",
    "better-sqlite3": "^11.10.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.6",
    "has-command": "^1.0.1",
    "pkgroll": "^2.14.3",
    "sql.js": "1.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "zx": "^8.7.1"
  }
}
