{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@huuyafwww/tsconfig-react",
  ],
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./src/components/*",
      ],
      "@styles/*": [
        "./src/styles/*",
      ],
    },
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
  ],
  "exclude": [
    "node_modules",
  ]
}
