{
  "name": "@trastocker/drizzle-helper",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "type": "module",
  "exports": {
    "./d1": {
      "require": {
        "types": "./dist/d1.d.cts",
        "default": "./dist/d1.cjs"
      },
      "import": {
        "types": "./dist/d1.d.mts",
        "default": "./dist/d1.mjs"
      }
    },
    "./sql-js": {
      "require": {
        "types": "./dist/sql-js.d.cts",
        "default": "./dist/sql-js.cjs"
      },
      "import": {
        "types": "./dist/sql-js.d.mts",
        "default": "./dist/sql-js.mjs"
      }
    },
    "./better-sqlite3": {
      "require": {
        "types": "./dist/better-sqlite3.d.cts",
        "default": "./dist/better-sqlite3.cjs"
      },
      "import": {
        "types": "./dist/better-sqlite3.d.mts",
        "default": "./dist/better-sqlite3.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll --minify --cleanDist",
    "build:watch": "pkgroll --watch",
    "clean": "rimraf node_modules dist",
    "lint:code": "eslint . --cache",
    "lint:type": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@trastocker/database-definition": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/sql.js": "^1.4.9",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.39.3",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "@huuyafwww/eslint-config-common": "^1.1.3",
    "@huuyafwww/eslint-config-node": "^1.1.3",
    "@huuyafwww/tsconfig-common": "^1.1.1",
    "pkgroll": "^2.12.1",
    "rolldown": "1.0.0-beta.7",
    "typescript": "^5.8.2"
  }
}
